<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef TsfDllPath ?>
  <?define TsfDllPath = "$(var.SourceDir)\dist\vietflow_tsf.dll" ?>
  <?endif ?>

  <Package Name="VietFlow"
           Manufacturer="VietFlow Team"
           Version="$(var.Version)"
           UpgradeCode="B9A5320F-D409-4BFB-A63A-9E3DA4D3A1F8"
           Scope="perMachine"
           Language="1033"
           Codepage="65001">

    <SummaryInformation Description="VietFlow - Bộ gõ tiếng Việt hiện đại" Manufacturer="VietFlow Team" />

    <MajorUpgrade DowngradeErrorMessage="Một phiên bản mới hơn của VietFlow đã được cài đặt."
                  AllowSameVersionUpgrades="no"
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs (ARP) Metadata -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.SourceDir)\assets\VietFlow.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPSIZE" Value="3500" />
    <Property Id="ARPCOMMENTS" Value="Bộ gõ tiếng Việt hiện đại, thông minh, độ trễ 0ms cho Windows" />
    <Property Id="ARPCONTACT" Value="VietFlow Team" />
    <Property Id="ARPHELPLINK" Value="https://github.com/KienPC1234/VietFlow/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/KienPC1234/VietFlow" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/KienPC1234/VietFlow/releases" />
    <Property Id="ARPHELPTELEPHONE" Value="https://github.com/KienPC1234/VietFlow" />
    <Property Id="ARPREADME" Value="https://github.com/KienPC1234/VietFlow#readme" />
    <Property Id="ARPNOREPAIR" Value="yes" />

    <!-- Graceful close only. Never force-kill the IME and lose in-flight text;
         offer Retry/Abort/Ignore while running, or a reboot if still locked. -->
    <util:CloseApplication Target="VietFlow.exe" CloseMessage="yes" Timeout="15"
                           Description="Please close VietFlow before updating or uninstalling."
                           PromptToContinue="yes" RebootPrompt="yes" />

    <!-- Custom Actions -->
    <!-- Only FINAL uninstall removes machine COM/TSF registration.
         On upgrade the TSF CLSID/path is stable; unregistering would break
         existing user layouts and flip the preserved use_tsf preference.
         This deferred action runs as SYSTEM, so it must not change HKCU or
         user configuration. Installer-owned shortcuts are MSI components. -->
    <CustomAction Id="UnregisterTSF"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[#VietFlowExe]&quot; --msi-final-unregister-tsf"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[#VietFlowExe]&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- Never unregister TSF on repair/major upgrade; only final uninstall.
           MSI manages its own shortcuts and registry marker on removal. -->
      <Custom Action="UnregisterTSF" Before="RemoveFiles"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- UI Configuration -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\assets\wix_banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\assets\wix_dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Khởi chạy VietFlow ngay bây giờ" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <UI>
      <!-- Dialog sequence: WelcomeDlg -> InstallDirDlg -> VerifyReadyDlg (skips LicenseAgreementDlg) -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />

      <!-- Launch on finish -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Directories and Components -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VietFlow">
        <Component Id="MainExecutable" Guid="3E47A55A-5DFB-4710-9E1D-5F6D9BF2A101">
          <File Id="VietFlowExe" Name="VietFlow.exe" Source="$(var.BinaryPath)" KeyPath="yes" />
        </Component>

        <Component Id="TsfLibrary" Guid="8C9D18FE-4B33-4D90-951E-C9A149802B02">
          <File Id="VietFlowTsfDll" Name="vietflow_tsf.dll" Source="$(var.TsfDllPath)" KeyPath="yes" />
        </Component>

        <Component Id="MsiMarker" Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D">
          <File Id="MsiMarkerFile" Source="$(var.SourceDir)\assets\.installed" KeyPath="yes" />
        </Component>


        <Component Id="AssetsComponent" Guid="F49E013A-38E2-46A2-9BF1-92D1D70B5B03">
          <File Id="NotificationSound" Source="$(var.SourceDir)\assets\notification.wav" KeyPath="yes" />
          <File Id="AppIconFile" Source="$(var.SourceDir)\assets\VietFlow.ico" />
          <File Id="ChangelogFile" Source="$(var.SourceDir)\CHANGELOG.md" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="72D6D860-24B3-4A59-A925-BDDE1A9B6104">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="VietFlow"
                  Description="Bộ gõ tiếng Việt hiện đại VietFlow"
                  Target="[!VietFlowExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFile Id="CleanStartMenuLnk" Name="VietFlow.lnk" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\VietFlow" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="A859E91E-D0B3-4FE0-9B2F-9B6CF5C38105">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="VietFlow"
                  Description="Bộ gõ tiếng Việt hiện đại VietFlow"
                  Target="[!VietFlowExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFile Id="CleanDesktopLnk" Name="VietFlow.lnk" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\VietFlow" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Common Shared Directory (%ProgramData%\VietFlow) for user config and macros -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CommonAppDataVietFlow" Name="VietFlow">
        <Component Id="CommonAppDataComponent" Guid="A9C8D7E6-F5B4-4321-8765-FEDCBA098765">
          <CreateFolder>
            <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" />
          </CreateFolder>
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Registry marker -->
    <Component Id="RegistryCleanup" Guid="D5A910E4-3A4B-4E38-9BF4-436DFB69C106" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\VietFlow" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature"
             Title="VietFlow"
             Description="Bộ gõ tiếng Việt VietFlow."
             Level="1"
             Display="expand">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="TsfLibrary" />
      <ComponentRef Id="MsiMarker" />
      <ComponentRef Id="AssetsComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="CommonAppDataComponent" />
      <ComponentRef Id="RegistryCleanup" />
    </Feature>

  </Package>
</Wix>