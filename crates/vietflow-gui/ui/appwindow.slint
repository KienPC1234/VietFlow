import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ScrollView, TabWidget, Switch } from "std-widgets.slint";

export struct MacroEntry {
    key: string,
    value: string,
}

export component AppWindow inherits Window {
    title: "VietFlow - Cấu hình bộ gõ tiếng Việt";
    icon: @image-url("../assets/app-logo.png");
    preferred-width: 780px;
    preferred-height: 640px;
    min-width: 680px;
    min-height: 520px;
    background: #18181b;
    default-font-family: "Segoe UI, sans-serif";

    // Callbacks to Rust
    callback save_config();
    callback reset_defaults();
    callback toggle_mode();
    callback add_macro(string, string);
    callback delete_macro(int);
    callback add_excluded_app(string);
    callback delete_excluded_app(int);
    callback convert_text(string, int, int) -> string;
    callback convert_clipboard(int, int);

    // Reactive Properties
    in-out property <bool> is_enabled: true;
    in-out property <int> method_index: 0;
    in-out property <int> charset_index: 0;
    in-out property <int> hotkey_index: 0;
    in-out property <bool> start_with_windows: false;
    in-out property <bool> notification_sound: true;

    // Typing properties
    in-out property <bool> spell_check: true;
    in-out property <bool> auto_restore: true;
    in-out property <bool> modern_style: false;
    in-out property <bool> free_marking: true;
    in-out property <bool> fix_shift_lag: true;
    in-out property <bool> consonant_shortcuts: false;
    in-out property <bool> auto_capitalize: false;
    in-out property <bool> use_clipboard: false;

    // Macro properties
    in-out property <bool> enable_macro: true;
    in-out property <bool> allow_macro_when_disabled: false;
    in-out property <[MacroEntry]> macro_list: [];
    in-out property <int> selected_macro_index: -1;

    // Excluded apps
    in-out property <[string]> excluded_apps: [];
    in-out property <int> selected_app_index: -1;

    // Converter tool state
    in-out property <int> conv_source_charset: 0;
    in-out property <int> conv_target_charset: 2;
    in-out property <string> conv_status: "";

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // TOP HEADER BAR
        Rectangle {
            height: 64px;
            background: #27272a;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3f3f46;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                alignment: space-between;

                // Logo and Title
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: @image-url("../assets/app-logo.png");
                        width: 38px;
                        height: 38px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "VietFlow";
                            font-size: 17px;
                            font-weight: 700;
                            color: #f4f4f5;
                        }
                        Text {
                            text: "Bộ gõ tiếng Việt thế hệ mới (100% Rust Core)";
                            font-size: 11px;
                            color: #a1a1aa;
                        }
                    }
                }

                // Live status toggle
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.is_enabled ? #dc2626 : #2563eb;
                        Text {
                            text: root.is_enabled ? "V" : "E";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.is_enabled ? "Tiếng Việt" : "English";
                            font-size: 13px;
                            font-weight: 600;
                            color: #f4f4f5;
                        }
                        Text {
                            text: root.is_enabled ? "Đang bật" : "Đã tạm dừng";
                            font-size: 10px;
                            color: root.is_enabled ? #4ade80 : #94a3b8;
                        }
                    }

                    Button {
                        text: root.is_enabled ? "Tắt [V]" : "Bật [E]";
                        clicked => {
                            root.toggle_mode();
                        }
                    }
                }
            }
        }

        // TAB WIDGET
        TabWidget {
            // TAB 1: TỔNG QUAN
            Tab {
                title: "Tổng quan";
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        // Method row
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 60px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Kiểu gõ tiếng Việt"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Hỗ trợ Telex, Simple Telex, VNI và VIQR"; font-size: 11px; color: #a1a1aa; }
                                }
                                ComboBox {
                                    width: 220px;
                                    model: ["Telex", "Simple Telex", "VNI", "VIQR"];
                                    current-index <=> root.method_index;
                                }
                            }
                        }

                        // Charset row
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 60px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Bảng mã ký tự"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Unicode dựng sẵn (NFC chuẩn), Tổ hợp, TCVN3 (ABC), VNI Windows"; font-size: 11px; color: #a1a1aa; }
                                }
                                ComboBox {
                                    width: 220px;
                                    model: ["Unicode dựng sẵn", "Unicode tổ hợp", "TCVN3 (ABC)", "VNI Windows"];
                                    current-index <=> root.charset_index;
                                }
                            }
                        }

                        // Hotkey row
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 60px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Phím chuyển đổi chế độ gõ [V / E]"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Tổ hợp phím nóng toàn cục chuyển nhanh giữa tiếng Việt và English"; font-size: 11px; color: #a1a1aa; }
                                }
                                ComboBox {
                                    width: 220px;
                                    model: ["Ctrl + Shift", "Alt + Z", "Ctrl + Space", "Alt + Shift"];
                                    current-index <=> root.hotkey_index;
                                }
                            }
                        }

                        // Start with windows switch
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 54px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Khởi động cùng Windows"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Tự động chạy VietFlow nền khi đăng nhập hệ thống"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch {
                                    checked <=> root.start_with_windows;
                                }
                            }
                        }

                        // Notification sound switch
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 54px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Âm thanh thông báo (Beep)"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Phát âm thanh nhẹ khi chuyển đổi trạng thái V / E bằng phím nóng"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch {
                                    checked <=> root.notification_sound;
                                }
                            }
                        }
                    }
                }
            }

            // TAB 2: BỘ GÕ & CHÍNH TẢ
            Tab {
                title: "Bộ gõ & Chính tả";
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Spellcheck
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Bật kiểm tra chính tả tiếng Việt"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Tự động phát hiện vần tiếng Việt chuẩn"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.spell_check; }
                            }
                        }

                        // Auto restore
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Tự động khôi phục phím cho từ tiếng Anh"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Tự hủy dấu khi từ đang gõ là từ tiếng Anh"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.auto_restore; }
                            }
                        }

                        // Modern style
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Đặt dấu thanh kiểu mới (oà, uỳ, oè)"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Đặt dấu trên âm chính theo chuẩn hiện đại"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.modern_style; }
                            }
                        }

                        // Free marking
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Cho phép gõ tự do"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Bỏ dấu ở bất kỳ vị trí nào trong từ mà không cần gõ ngay sau nguyên âm"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.free_marking; }
                            }
                        }

                        // Fix shift lag
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Tự sửa dính Shift chữ thứ hai (VIệt -> Việt)"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Khắc phục triệt để lỗi khi gõ nhanh nhả Shift trễ"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.fix_shift_lag; }
                            }
                        }

                        // Consonant shortcuts
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Tốc ký phụ âm đầu (f -> ph, j -> gi, w -> qu)"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Tăng tốc độ gõ bằng các phím tắt phụ âm"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.consonant_shortcuts; }
                            }
                        }

                        // Auto capitalize
                        Rectangle {
                            background: #202023;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #333338;
                            height: 50px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Tự động viết hoa sau Enter và dấu chấm (. ! ?)"; font-weight: 600; font-size: 13px; color: #f4f4f5; }
                                    Text { text: "Viết hoa chữ cái đầu tiên của câu tiếp theo"; font-size: 11px; color: #a1a1aa; }
                                }
                                Switch { checked <=> root.auto_capitalize; }
                            }
                        }
                    }
                }
            }

            // TAB 3: GÕ TẮT & BIẾN ĐỘNG
            Tab {
                title: "Gõ tắt & Biến động";
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 20px;
                        Switch {
                            text: "Bật gõ tắt (Macro)";
                            checked <=> root.enable_macro;
                        }
                        Switch {
                            text: "Cho phép gõ tắt khi ở chế độ [E]";
                            checked <=> root.allow_macro_when_disabled;
                        }
                    }

                    // Smart variables banner
                    Rectangle {
                        height: 44px;
                        background: #1e293b;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #38bdf8;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;
                            Text {
                                text: "Hỗ trợ biến động: @date (ngày), @time (giờ), @datetime, @clipboard (dán), @tab, @newline";
                                font-size: 11px;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Macro list view
                    Rectangle {
                        background: #202023;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #333338;
                        VerticalLayout {
                            padding: 8px;
                            ScrollView {
                                VerticalLayout {
                                    spacing: 4px;
                                    for entry[i] in root.macro_list: Rectangle {
                                        height: 32px;
                                        background: root.selected_macro_index == i ? #3b82f6 : (Math.mod(i, 2) == 0 ? #27272a : #18181b);
                                        border-radius: 4px;
                                        TouchArea {
                                            clicked => { root.selected_macro_index = i; }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: entry.key;
                                                font-weight: 700;
                                                width: 140px;
                                                color: #f4f4f5;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "→ " + entry.value;
                                                color: #e2e8f0;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Add / Delete macro inputs
                    HorizontalLayout {
                        spacing: 8px;
                        macro_key_input := LineEdit {
                            placeholder-text: "Từ tắt (vd: vn)";
                            width: 140px;
                        }
                        macro_val_input := LineEdit {
                            placeholder-text: "Cụm thay thế (vd: Việt Nam hoặc @date)";
                        }
                        Button {
                            text: "Thêm / Sửa";
                            clicked => {
                                if (macro_key_input.text != "" && macro_val_input.text != "") {
                                    root.add_macro(macro_key_input.text, macro_val_input.text);
                                    macro_key_input.text = "";
                                    macro_val_input.text = "";
                                }
                            }
                        }
                        Button {
                            text: "Xóa từ";
                            clicked => {
                                if (root.selected_macro_index >= 0) {
                                    root.delete_macro(root.selected_macro_index);
                                }
                            }
                        }
                    }
                }
            }

            // TAB 4: GAME & LOẠI TRỪ
            Tab {
                title: "Game & Loại trừ";
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: "Chế độ Game Mode: Tự động chuyển về tiếng Anh [E] khi chạy các game hoặc ứng dụng sau:";
                        font-size: 12px;
                        color: #a1a1aa;
                    }

                    // Excluded apps list
                    Rectangle {
                        background: #202023;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #333338;
                        VerticalLayout {
                            padding: 8px;
                            ScrollView {
                                VerticalLayout {
                                    spacing: 4px;
                                    for app[idx] in root.excluded_apps: Rectangle {
                                        height: 32px;
                                        background: root.selected_app_index == idx ? #3b82f6 : (Math.mod(idx, 2) == 0 ? #27272a : #18181b);
                                        border-radius: 4px;
                                        TouchArea {
                                            clicked => { root.selected_app_index = idx; }
                                        }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: "🎮  " + app;
                                                font-weight: 600;
                                                color: #f4f4f5;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        app_input := LineEdit {
                            placeholder-text: "Nhập tên file thực thi (ví dụ: cs2.exe hoặc valorant.exe)";
                        }
                        Button {
                            text: "Thêm ứng dụng";
                            clicked => {
                                if (app_input.text != "") {
                                    root.add_excluded_app(app_input.text);
                                    app_input.text = "";
                                }
                            }
                        }
                        Button {
                            text: "Xóa chọn";
                            clicked => {
                                if (root.selected_app_index >= 0) {
                                    root.delete_excluded_app(root.selected_app_index);
                                }
                            }
                        }
                    }
                }
            }

            // TAB 5: CÔNG CỤ & GIỚI THIỆU
            Tab {
                title: "Công cụ & Giới thiệu";
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        // Clipboard converter section
                        Rectangle {
                            background: #202023;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #333338;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "Công cụ chuyển mã nhanh văn bản & Clipboard";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #f4f4f5;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Mã nguồn:"; vertical-alignment: center; font-size: 12px; color: #a1a1aa; }
                                    ComboBox {
                                        width: 170px;
                                        model: ["Unicode", "Unicode tổ hợp", "TCVN3 (ABC)", "VNI Windows"];
                                        current-index <=> root.conv_source_charset;
                                    }
                                    Text { text: "Mã đích:"; vertical-alignment: center; font-size: 12px; color: #a1a1aa; }
                                    ComboBox {
                                        width: 170px;
                                        model: ["Unicode", "Unicode tổ hợp", "TCVN3 (ABC)", "VNI Windows"];
                                        current-index <=> root.conv_target_charset;
                                    }
                                    Button {
                                        text: "Chuyển mã Clipboard";
                                        clicked => {
                                            root.convert_clipboard(root.conv_source_charset, root.conv_target_charset);
                                        }
                                    }
                                }

                                conv_input := TextEdit {
                                    height: 90px;
                                    text: "Nhập văn bản cần chuyển mã vào đây...";
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Thực hiện chuyển mã";
                                        clicked => {
                                            conv_input.text = root.convert_text(conv_input.text, root.conv_source_charset, root.conv_target_charset);
                                        }
                                    }
                                    Text {
                                        text: root.conv_status;
                                        font-size: 12px;
                                        color: #4ade80;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // About section
                        Rectangle {
                            background: #202023;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #333338;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 16px;
                                    Image {
                                        source: @image-url("../assets/app-logo.png");
                                        width: 48px;
                                        height: 48px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "VietFlow - Phiên bản 1.0.4";
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: #f4f4f5;
                                        }
                                        Text {
                                            text: "Kiến trúc mới: 100% Rust Core + Native Windows Host + Fcitx5 Linux";
                                            font-size: 12px;
                                            color: #a1a1aa;
                                        }
                                        Text {
                                            text: "Giấy phép: Mã nguồn mở GPLv3 / MIT · Kế thừa và phát triển từ UniKey";
                                            font-size: 11px;
                                            color: #71717a;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // BOTTOM ACTION BAR
        Rectangle {
            height: 52px;
            background: #27272a;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3f3f46;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Button {
                    text: "Khôi phục mặc định";
                    clicked => {
                        root.reset_defaults();
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: "Lưu cấu hình";
                        clicked => {
                            root.save_config();
                        }
                    }
                }
            }
        }
    }
}
