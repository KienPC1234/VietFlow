<Window x:Class="VietFlow.Windows.TrayIconDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tùy chỉnh Tray icon"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Màu badge và màu chữ V / E trên khay hệ thống"
                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Border x:Name="BadgeV" Width="72" Height="72" CornerRadius="16" Margin="0,0,18,0">
                <TextBlock Text="V" FontSize="38" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="BadgeE" Width="72" Height="72" CornerRadius="16">
                <TextBlock Text="E" FontSize="38" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tiếng Việt · màu trên" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
            <Button x:Name="BtnVnTop" Grid.Column="1" Style="{StaticResource BtnGhost}" Click="BtnVnTop_Click" Margin="0,3"/>

            <TextBlock Grid.Row="1" Text="Tiếng Việt · màu dưới" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
            <Button x:Name="BtnVnBottom" Grid.Row="1" Grid.Column="1" Style="{StaticResource BtnGhost}" Click="BtnVnBottom_Click" Margin="0,3"/>

            <TextBlock Grid.Row="2" Text="English · màu trên" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
            <Button x:Name="BtnEnTop" Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnGhost}" Click="BtnEnTop_Click" Margin="0,3"/>

            <TextBlock Grid.Row="3" Text="English · màu dưới" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
            <Button x:Name="BtnEnBottom" Grid.Row="3" Grid.Column="1" Style="{StaticResource BtnGhost}" Click="BtnEnBottom_Click" Margin="0,3"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Style="{StaticResource BtnGhost}" Padding="18,8" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Lưu" Style="{StaticResource BtnPrimary}" Padding="18,8" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
