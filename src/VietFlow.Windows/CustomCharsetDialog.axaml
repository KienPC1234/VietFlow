<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VietFlow.Windows.CustomCharsetDialog"
        Title="Bảng mã tùy chỉnh"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI"
        FontSize="13">

  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Bảng mã tùy chỉnh" Classes="h1"/>
      <TextBlock Text="Mỗi dòng là một ký tự tiếng Việt. Nhập mã thay thế vào cột bên phải; để trống sẽ dùng Unicode."
                 Classes="desc" Margin="0,4,0,0"/>
    </StackPanel>

    <DataGrid x:Name="DgMap" Grid.Row="1"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ký tự" Binding="{Binding Glyph}" IsReadOnly="True" Width="120"/>
        <DataGridTextColumn Header="Mã tùy chỉnh" Binding="{Binding Code, Mode=TwoWay}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <TextBlock Text="Để trống = dùng Unicode tương ứng" Classes="muted" VerticalAlignment="Center"/>
      <Button x:Name="BtnFillUnicode" Grid.Column="1" Content="Nạp Unicode" Classes="ghost" Margin="0,0,8,0" Click="BtnFillUnicode_Click"/>
      <Button x:Name="BtnClear" Grid.Column="2" Content="Xóa tất cả" Classes="ghost" Margin="0,0,8,0" Click="BtnClear_Click"/>
      <Button x:Name="BtnCancel" Grid.Column="3" Content="Hủy" Classes="ghost" Margin="0,0,8,0" Click="BtnCancel_Click"/>
      <Button x:Name="BtnSave" Grid.Column="4" Content="Lưu" Classes="primary" Click="BtnSave_Click"/>
    </Grid>
  </Grid>
</Window>
