<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme palette -->
    <SolidColorBrush x:Key="BrushBackground" Color="#0B1220"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#111827"/>
    <SolidColorBrush x:Key="BrushChrome" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#1F2937"/>
    <SolidColorBrush x:Key="BrushMutedHover" Color="#334155"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#263244"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#3B4A60"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushTextPrimaryAlt" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushPrimary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="#172554"/>
    <SolidColorBrush x:Key="BrushPrimarySoftBorder" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#F87171"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="BrushDangerSoftHover" Color="#4C2424"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#4ADE80"/>
    <SolidColorBrush x:Key="BrushSuccessDark" Color="#22C55E"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#14321F"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#3A2A0A"/>
    <SolidColorBrush x:Key="BrushPurple" Color="#C084FC"/>
    <SolidColorBrush x:Key="BrushPurpleSoft" Color="#2A1A3A"/>
    <SolidColorBrush x:Key="BrushInput" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushShadow" Color="#000000"/>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushPrimary}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="RowBackground" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>
</ResourceDictionary>
