<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette -->
    <SolidColorBrush x:Key="BrushBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushChrome" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushMutedHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushTextPrimaryAlt" Color="#334155"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrushPrimarySoftBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BrushDangerSoftHover" Color="#FECACA"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#16A34A"/>
    <SolidColorBrush x:Key="BrushSuccessDark" Color="#059669"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#D97706"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BrushPurple" Color="#9333EA"/>
    <SolidColorBrush x:Key="BrushPurpleSoft" Color="#FAF5FF"/>
    <SolidColorBrush x:Key="BrushInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushShadow" Color="#0F172A"/>

    <!-- Keep default WPF controls readable in both themes -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushPrimary}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        <Setter Property="RowBackground" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    </Style>
</ResourceDictionary>
