<Window x:Class="VietFlow.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietFlow"
        Icon="Assets/app-logo.png"
        Height="620" Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Indicator Bar -->
                                <Border x:Name="Indicator" Width="3" Height="18" Background="{DynamicResource BrushPrimary}" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                                <Path x:Name="IconPath" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{DynamicResource BrushTextSecondary}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LabelText" Grid.Column="1" Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource BrushTextPrimaryAlt}" FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushMuted}"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushPrimarySoft}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource BrushPrimary}"/>
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style (Minimize/Close) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path x:Name="Pt" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBorder}"/>
                                <Setter TargetName="Pt" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path x:Name="Pt" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDangerHover}"/>
                                <Setter TargetName="Pt" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window DropShadow Container -->
    <Border Margin="16" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Custom Drag Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BrushChrome}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo + Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="{DynamicResource BrushPrimary}" CornerRadius="6" Margin="0,0,10,0">
                            <Path Data="{StaticResource GeoLogo}" Fill="White" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="VietFlow" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushPrimarySoft}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text=".NET 10" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Minimize and Close Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlBtn}" Tag="{StaticResource GeoMinus}" Click="BtnMinimize_Click" Margin="0,0,2,0"/>
                        <Button Style="{StaticResource WindowCloseBtn}" Tag="{StaticResource GeoClose}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Engine Status Card -->
                        <Border Margin="12,14,12,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Badge -->
                                <Border x:Name="BdLiveBadge" Width="36" Height="36" Background="{DynamicResource BrushDanger}" CornerRadius="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLiveLetter" Text="V" FontWeight="Bold" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLiveTitle" Text="Tiếng Việt" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock x:Name="TxtLiveSubtitle" Text="Đang bật (Sẵn sàng)" FontSize="11" Foreground="{DynamicResource BrushSuccess}"/>
                                </StackPanel>

                                <!-- Interactive Live Switch -->
                                <CheckBox x:Name="SwLiveMode" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center" Click="SwLiveMode_Click" IsChecked="True"/>

                                <!-- Current Hotkey Pill -->
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BrushMuted}" CornerRadius="6" Padding="8,4" Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtHotkeyBadge" Text="Chuyển: Ctrl + Shift" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Nav List -->
                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                            <RadioButton x:Name="NavOverview" Style="{StaticResource NavButtonStyle}" Content="Tổng quan"
                                         Tag="{StaticResource GeoDashboard}" IsChecked="True" Click="NavButton_Click"/>
                            <RadioButton x:Name="NavTyping" Style="{StaticResource NavButtonStyle}" Content="Bộ gõ &amp; Chính tả"
                                         Tag="{StaticResource GeoKeyboard}" Click="NavButton_Click"/>
                            <RadioButton x:Name="NavMacro" Style="{StaticResource NavButtonStyle}" Content="Gõ tắt &amp; Biến động"
                                         Tag="{StaticResource GeoMacro}" Click="NavButton_Click"/>
                            <RadioButton x:Name="NavGame" Style="{StaticResource NavButtonStyle}" Content="Game &amp; Ứng dụng"
                                         Tag="{StaticResource GeoGame}" Click="NavButton_Click"/>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Content="Giới thiệu"
                                         Tag="{StaticResource GeoInfo}" Click="NavButton_Click"/>
                            <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavButtonStyle}" Content="Nâng cao"
                                         Tag="{StaticResource GeoSparkles}" Click="NavButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Viewport -->
                <Grid Grid.Column="1" Background="{DynamicResource BrushSurface}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid>
                            <!-- VIEW 1: TỔNG QUAN -->
                            <StackPanel x:Name="ViewOverview" Visibility="Visible">
                                <TextBlock x:Name="LblOverviewTitle" Text="Tổng quan &amp; Thiết lập" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblOverviewDesc" Text="Bảng mã, kiểu gõ và các tùy chọn tích hợp hệ thống." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <TextBlock x:Name="LblSectionInput" Text="THIẾT LẬP BỘ GÕ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>

                                <!-- Card: Bảng mã -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushPrimarySoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoKeyboard}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblCharsetTitle" Text="Bảng mã ký tự" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblCharsetDesc" Text="Mặc định Unicode NFC chuẩn quốc tế" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ComboBox x:Name="CboCharset" Style="{StaticResource ModernComboBox}" SelectionChanged="CboCharset_SelectionChanged"/>
                                            <Button x:Name="BtnEditCharset" Content="Sửa bảng mã..." Style="{StaticResource BtnGhost}" Padding="8,5" Margin="0,6,0,0" Click="BtnEditCharset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card: Kiểu gõ -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushSuccessSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoKeyboard}" Fill="{DynamicResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblMethodTitle" Text="Kiểu gõ" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblMethodDesc" Text="Hỗ trợ Telex, Simple Telex, và VNI" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CboMethod" Grid.Column="2" Style="{StaticResource ModernComboBox}"
                                                  ToolTip="Simple Telex không đổi phím w đơn lẻ thành chữ ư"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Phím chuyển -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="{DynamicResource BrushPurpleSoft}" CornerRadius="8" Margin="0,0,14,0">
                                                <Path Data="{StaticResource GeoRefresh}" Fill="{DynamicResource BrushPurple}" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="LblSwitchKeyTitle" Text="Phím chuyển đổi (V / E)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="LblSwitchKeyDesc" Text="Hỗ trợ gán phím tùy biến thuận tiện" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CboToggleHotkey" Grid.Column="2" Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="CboToggleHotkey_SelectionChanged"/>
                                        </Grid>
                                        <Grid x:Name="RowCustomHotkey" Margin="48,10,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LblCustomHotkeyPrompt" Text="Phím tắt tự gán:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                                                <TextBlock x:Name="LblCustomHotkeyHint" Text="Bấm vào ô bên phải và nhấn tổ hợp phím muốn gán" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtCustomHotkey" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True" Cursor="Hand" TextAlignment="Center" FontWeight="SemiBold"
                                                     PreviewKeyDown="TxtCustomHotkey_PreviewKeyDown" Text="Bấm để gán phím"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Ngôn ngữ giao diện -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushSuccessSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoInfo}" Fill="{DynamicResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblUiLangTitle" Text="Ngôn ngữ giao diện (Language)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblUiLangDesc" Text="Chọn hiển thị Tiếng Việt hoặc English" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CboUiLanguage" Grid.Column="2" Style="{StaticResource ModernComboBox}" SelectionChanged="CboUiLanguage_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="LblSectionSystem" Text="TÍCH HỢP HỆ THỐNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,10,0,8"/>

                                <!-- Card: Khởi động cùng Windows -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushWarningSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource BrushWarning}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblStartWithWinTitle" Text="Khởi động cùng Windows (Silent Run as Admin)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblStartWithWinDesc" Text="Tự động bật khi đăng nhập qua Task Scheduler với quyền cao, không hiện bảng hỏi UAC" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwStartWithWindows" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Chế độ màu -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushPurpleSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoPalette}" Fill="{DynamicResource BrushPurple}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblThemeTitle" Text="Chế độ màu (Theme)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblThemeDesc" Text="Theo hệ thống, Sáng hoặc Tối" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CboTheme" Grid.Column="2" Style="{StaticResource ModernComboBox}" SelectionChanged="CboTheme_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Âm thanh thông báo -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushWarningSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource BrushWarning}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblSoundTitle" Text="Âm thanh thông báo" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblSoundDesc" Text="Phát âm thanh khi chuyển đổi V / E" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwNotificationSound" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Tùy chỉnh Tray icon -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushPrimarySoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoPalette}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblTrayTitle" Text="Tùy chỉnh Tray icon" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblTrayDesc" Text="Màu badge và màu chữ V / E trên khay hệ thống" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="BtnCustomizeTray" Grid.Column="2" Content="Tùy chỉnh..." Style="{StaticResource BtnGhost}" Click="BtnCustomizeTray_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- VIEW 2: BỘ GÕ & CHÍNH TẢ -->
                            <StackPanel x:Name="ViewTyping" Visibility="Collapsed">
                                <TextBlock x:Name="LblTypingTitle" Text="Bộ gõ &amp; Chính tả" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblTypingDesc" Text="Thuật toán sửa lỗi dính Shift, tốc ký phụ âm và quy tắc bỏ dấu chuẩn." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <TextBlock x:Name="LblKillerFeatures" Text="TÍNH NĂNG ĐẶC BIỆT (KILLER FEATURES)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>

                                <!-- Card: Fix Shift-Lag -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushSuccessSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoSparkles}" Fill="{DynamicResource BrushSuccessDark}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblShiftLagTitle" Text="Tự sửa dính Shift chữ thứ hai (VIệt -> Việt, TRường -> Trường)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblShiftLagDesc" Text="Khắc phục triệt để lỗi gõ nhanh nhả phím Shift chậm làm viết hoa chữ thứ hai" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwFixShiftLag" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Tốc ký phụ âm đầu -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushPrimarySoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoMacro}" Fill="{DynamicResource BrushPrimary}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblConsonantTitle" Text="Tốc ký phụ âm đầu (f -> ph, j -> gi, w -> qu)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblConsonantDesc" Text="Tăng tốc độ gõ bằng cách thay thế các phím đơn cho phụ âm ghép đầu câu" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwConsonantShortcuts" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Đặt dấu kiểu mới -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{DynamicResource BrushPurpleSoft}" CornerRadius="8" Margin="0,0,14,0">
                                            <Path Data="{StaticResource GeoKeyboard}" Fill="{DynamicResource BrushPurple}" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblModernStyleTitle" Text="Đặt dấu thanh kiểu mới (oà, uỳ, oè thay vì òa, úy, òe)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblModernStyleDesc" Text="Quy chuẩn đặt dấu thanh trên âm chính hiện đại của Bộ Giáo Dục" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwModernStyle" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="LblSectionSpelling" Text="QUY TẮC CHÍNH TẢ &amp; BỎ DẤU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,10,0,8"/>

                                <!-- Card: Gõ tự do -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblFreeMarkingTitle" Text="Cho phép gõ tự do" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblFreeMarkingDesc" Text="Bỏ dấu ở bất kỳ vị trí nào trong từ mà không cần gõ ngay sau nguyên âm" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwFreeMarking" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Kiểm tra chính tả -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblSpellCheckTitle" Text="Bật kiểm tra chính tả tiếng Việt" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblSpellCheckDesc" Text="Nhận diện cấu trúc âm tiết chuẩn; ngắt bỏ dấu khi gõ các từ không có trong tiếng Việt" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwSpellCheck" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Tự động khôi phục từ tiếng Anh -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAutoRestoreTitle" Text="Tự động khôi phục phím cho từ tiếng Anh (cool, post, windows)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblAutoRestoreDesc" Text="Tự động trả lại các ký tự gốc khi từ gõ vào là từ tiếng Anh hoàn chỉnh" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwAutoRestore" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Luôn dùng Clipboard -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblUseClipboardTitle" Text="Luôn sử dụng Clipboard cho Unicode" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblUseClipboardDesc" Text="Gửi ký tự qua bộ nhớ tạm thay vì phím ảo (dành cho game hoặc phần mềm cũ không nhận chữ có dấu)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwUseClipboardForUnicode" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Card: Tự động viết hoa sau Enter . ! ? -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblAutoCapTitle" Text="Tự động viết hoa sau &quot;Enter . ! ?&quot;" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblAutoCapDesc" Text="Viết hoa chữ cái đầu tiên của câu tiếp theo" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwAutoCapitalize" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- VIEW 3: GÕ TẮT (MACRO) -->
                            <StackPanel x:Name="ViewMacro" Visibility="Collapsed">
                                <TextBlock x:Name="LblMacroTitle" Text="Gõ tắt &amp; Biến động" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblMacroDesc" Text="Quản lý các cụm từ viết tắt và hỗ trợ biến động chèn ngày giờ, nội dung copy." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <!-- Toggles -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblEnableMacroTitle" Text="Bật tính năng gõ tắt (Macro)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblEnableMacroDesc" Text="Tự động bung từ thay thế khi nhấn phím Cách (Space) hoặc dấu câu" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwEnableMacro" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblMacroWhenDisabledTitle" Text="Cho phép gõ tắt cả khi đang tắt tiếng Việt [E]" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblMacroWhenDisabledDesc" Text="Vẫn mở rộng các từ viết tắt ngay cả khi biểu tượng khay đang là chữ E" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwMacroWhenDisabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Dynamic Variables Guide Banner -->
                                <Border Background="{DynamicResource BrushPrimarySoft}" BorderBrush="{DynamicResource BrushPrimarySoftBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource GeoInfo}" Fill="{DynamicResource BrushPrimary}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Biến động thông minh trong cụm từ thay thế:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushPrimaryPressed}"/>
                                            <TextBlock Text="• @date : Tự động chèn ngày hiện tại (ví dụ: 28/10/2026)&#x0a;• @time : Tự động chèn giờ hiện tại (ví dụ: 13:45)&#x0a;• @clipboard : Tự động dán nội dung văn bản đang có trong Clipboard" FontSize="11" Foreground="{DynamicResource BrushPrimaryPressed}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Macro Search & Actions Header -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMacroSearch" Style="{StaticResource ModernTextBox}" Margin="0,0,6,0"
                                             Tag="Tìm từ gõ tắt..." TextChanged="TxtMacroSearch_TextChanged"/>
                                    <Button x:Name="BtnAddSampleMacros" Grid.Column="1" Content="Thêm mẫu" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="BtnAddSampleMacros_Click"/>
                                    <Button x:Name="BtnImportMacros" Grid.Column="2" Content="Nhập .txt" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="BtnImportMacros_Click"/>
                                    <Button x:Name="BtnExportMacros" Grid.Column="3" Content="Xuất .txt" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="BtnExportMacros_Click"/>
                                    <Button x:Name="BtnClearMacros" Grid.Column="4" Content="Xóa hết" Style="{StaticResource BtnGhost}" Click="BtnClearMacros_Click"/>
                                </Grid>

                                <!-- Macro DataGrid -->
                                <DataGrid x:Name="DgMacros" Height="170" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                          Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushMuted}"
                                          RowHeight="32" SelectionChanged="DgMacros_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ColMacroKey" Header="Từ viết tắt" Binding="{Binding Key}" Width="140" FontWeight="SemiBold"/>
                                        <DataGridTextColumn x:Name="ColMacroVal" Header="Cụm thay thế" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtMacroCount" Text="0 từ gõ tắt" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                </Grid>

                                <!-- Macro Input Controls -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMacroKey" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" Tag="Từ gõ tắt"/>
                                    <TextBox x:Name="TxtMacroValue" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" Tag="Cụm thay thế"/>
                                    <Button x:Name="BtnAddMacro" Grid.Column="2" Content="Lưu từ" Style="{StaticResource BtnPrimary}" Padding="14,6" Margin="0,0,6,0" Click="BtnAddMacro_Click"/>
                                    <Button x:Name="BtnDeleteMacro" Grid.Column="3" Content="Xóa" Style="{StaticResource BtnDanger}" Padding="12,6" Click="BtnDeleteMacro_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- VIEW 4: GAME & ỨNG DỤNG -->
                            <StackPanel x:Name="ViewGame" Visibility="Collapsed">
                                <TextBlock x:Name="LblGameTitle" Text="Game &amp; Ứng dụng thông minh" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblGameDesc" Text="Tự động chuyển chế độ tiếng Anh hoặc bỏ qua hook để không kẹt phím khi chơi game." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <TextBlock x:Name="LblExcludedAppsHeader" Text="DANH SÁCH ỨNG DỤNG LOẠI TRỪ (GAME MODE)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <Button x:Name="BtnPickRunningProcess" Content="Chọn tiến trình..." Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Click="BtnPickRunningProcess_Click"/>
                                    <Button x:Name="BtnBrowseExe" Content="Duyệt file .exe..." Style="{StaticResource BtnGhost}" Margin="0,0,6,0" Click="BtnBrowseExe_Click"/>
                                    <Button x:Name="BtnClearExcludedApps" Content="Xóa hết" Style="{StaticResource BtnGhost}" Click="BtnClearExcludedApps_Click"/>
                                </StackPanel>

                                <ListBox x:Name="LstExcludedApps" Height="170" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                         Padding="6" SelectionMode="Single"/>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtExcludedAppsCount" Text="0 ứng dụng loại trừ" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAppProcess" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" Tag="Nhập file .exe (ví dụ: cs2.exe)"/>
                                    <Button x:Name="BtnAddApp" Grid.Column="1" Content="Thêm thủ công" Style="{StaticResource BtnPrimary}" Padding="14,6" Margin="0,0,6,0" Click="BtnAddApp_Click"/>
                                    <Button x:Name="BtnDeleteApp" Grid.Column="2" Content="Xóa" Style="{StaticResource BtnDanger}" Padding="12,6" Click="BtnDeleteApp_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- VIEW 5: GIỚI THIỆU -->
                            <StackPanel x:Name="ViewAbout" Visibility="Collapsed">
                                <TextBlock x:Name="LblAboutTitle" Text="Giới thiệu VietFlow" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblAboutDesc" Text="Bộ gõ tiếng Việt hiệu năng cao, thuần C# trên .NET 10." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="56" Height="56" Background="{DynamicResource BrushPrimary}" CornerRadius="14" Margin="0,0,16,0">
                                                <Path Data="{StaticResource GeoLogo}" Fill="White" Width="28" Height="28" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="VietFlow" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtAboutVersion" Text="Phiên bản 1.0.4" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,16,0,14"/>

                                        <TextBlock x:Name="TxtAboutRuntime" Text=".NET 10 · WPF · Win32 low-level keyboard hook" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAboutEngine" Text="Engine: VietFlow.Core (thuần C#, zero-allocation)" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAboutLicense" Text="Giấy phép GNU GPL v3.0 · Dựa trên UniKey của Phạm Kim Long" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14"/>

                                        <TextBlock x:Name="LblAboutLinks" Text="LIÊN KẾT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                                <Hyperlink NavigateUri="https://github.com" RequestNavigate="AboutLink_RequestNavigate" Foreground="{DynamicResource BrushPrimary}">GitHub</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="  ·  " Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                                <Hyperlink NavigateUri="https://www.unikey.org" RequestNavigate="AboutLink_RequestNavigate" Foreground="{DynamicResource BrushPrimary}">UniKey</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="  ·  " Foreground="{DynamicResource BrushTextMuted}"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                                <Hyperlink NavigateUri="https://evkeyvn.com" RequestNavigate="AboutLink_RequestNavigate" Foreground="{DynamicResource BrushPrimary}">EVKey</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Background="{DynamicResource BrushPrimarySoft}" BorderBrush="{DynamicResource BrushPrimarySoftBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                            <TextBlock x:Name="TxtAboutNote" Text="Cảm ơn bạn đã sử dụng VietFlow. Nhấn Ctrl + Shift để chuyển nhanh giữa tiếng Việt [V] và English [E]."
                                                       FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- VIEW 6: NÂNG CAO -->
                            <StackPanel x:Name="ViewAdvanced" Visibility="Collapsed">
                                <TextBlock x:Name="LblAdvancedTitle" Text="Cấu hình nâng cao" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblAdvancedDesc" Text="Tùy chỉnh các danh sách từ và tham số ít dùng của engine." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16"/>

                                <TextBlock Text="DANH SÁCH TỪ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="LblKeywordsTitle" Text="Từ tiếng Anh / từ ngoại lai" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="LblKeywordsDesc" Text="Mỗi dòng một từ. Các từ này sẽ không bị bỏ dấu tiếng Việt (dùng cho lập trình / tiếng Anh)."
                                                   FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBox x:Name="TxtEnglishKeywords" Height="230" AcceptsReturn="True" TextChanged="TxtEnglishKeywords_TextChanged" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" Padding="8"
                                                 Background="{DynamicResource BrushInput}" Foreground="{DynamicResource BrushTextPrimary}"
                                                 BorderBrush="{DynamicResource BrushBorderStrong}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtKeywordsCount" Text="0 từ" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnResetKeywords" Grid.Column="1" Content="Khôi phục mặc định" Style="{StaticResource BtnGhost}" Padding="12,6" Margin="0,0,8,0" Click="BtnResetKeywords_Click"/>
                                            <Button x:Name="BtnSaveKeywords" Grid.Column="2" Content="Lưu danh sách" Style="{StaticResource BtnPrimary}" Padding="14,6" Click="BtnSaveKeywords_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblForeignTitle" Text="Phụ âm đầu nước ngoài" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="LblForeignDesc" Text="Các chữ cái đầu này sẽ không nhận dấu tiếng Việt (mặc định: fjwz)." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtForeignInitials" Grid.Column="1" Style="{StaticResource ModernTextBox}" MaxLength="26" FontFamily="Consolas"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="HỆ THỐNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,10,0,8"/>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Tệp cấu hình" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TxtConfigPath" Text="%APPDATA%\VietFlow\vietflow_config.json" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="BtnOpenConfigFolder" Grid.Column="1" Content="Mở thư mục" Style="{StaticResource BtnGhost}" Padding="12,6" Click="BtnOpenConfigFolder_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Bottom Actions Bar -->
            <Border Grid.Row="2" Background="{DynamicResource BrushChrome}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnReset" Content="Khôi phục mặc định" Style="{StaticResource BtnGhost}" Click="BtnReset_Click"/>

                    <Button x:Name="BtnClose" Grid.Column="2" Content="Đóng" Style="{StaticResource BtnGhost}" Margin="0,0,10,0" Click="BtnClose_Click"/>
                    <Button x:Name="BtnSave" Grid.Column="3" Content="Lưu cấu hình" Style="{StaticResource BtnPrimary}" Click="BtnSave_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
