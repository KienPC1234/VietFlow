<Window x:Class="VietFlow.Windows.CustomCharsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng mã tùy chỉnh"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Bảng mã tùy chỉnh" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="Mỗi dòng là một ký tự tiếng Việt. Nhập mã thay thế vào cột bên phải; để trống sẽ dùng Unicode."
                       FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid x:Name="DgMap" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  Background="{DynamicResource BrushSurface}"
                  Foreground="{DynamicResource BrushTextPrimary}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  RowBackground="{DynamicResource BrushSurface}"
                  AlternatingRowBackground="{DynamicResource BrushMuted}"
                  HorizontalGridLinesBrush="{DynamicResource BrushBorder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ký tự" Binding="{Binding Glyph}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Mã tùy chỉnh" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Để trống = dùng Unicode tương ứng" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
            <Button x:Name="BtnFillUnicode" Grid.Column="1" Content="Nạp Unicode" Style="{StaticResource BtnGhost}" Padding="12,7" Margin="0,0,8,0" Click="BtnFillUnicode_Click"/>
            <Button x:Name="BtnClear" Grid.Column="2" Content="Xóa tất cả" Style="{StaticResource BtnGhost}" Padding="12,7" Margin="0,0,8,0" Click="BtnClear_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="3" Content="Hủy" Style="{StaticResource BtnGhost}" Padding="14,7" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Grid.Column="4" Content="Lưu" Style="{StaticResource BtnPrimary}" Padding="16,7" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
