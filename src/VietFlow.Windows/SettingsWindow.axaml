<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VietFlow.Windows.SettingsWindow"
        Title="VietFlow"
        Icon="avares://VietFlow/Assets/app-logo.png"
        Width="940" Height="900"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI"
        FontSize="13">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource ChromeBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="0,0,0,1"
            Padding="18,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Width="32" Height="32" Source="avares://VietFlow/Assets/app-logo.png" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="VietFlow" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock x:Name="TxtAppTagline" Text="Vietnamese input engine" Classes="muted"/>
        </StackPanel>

        <Border Grid.Column="2" Classes="card" Padding="10,7" Margin="0">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <Border x:Name="BdLiveBadge" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource DangerBrush}">
              <TextBlock x:Name="TxtLiveLetter" Text="V" FontWeight="Bold" FontSize="14" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtLiveTitle" Text="Tiếng Việt" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="TxtLiveSubtitle" Text="Đang bật (Sẵn sàng)" FontSize="10"
                         Foreground="{DynamicResource SuccessBrush}"/>
              <TextBlock x:Name="TxtHotkeyBadge" Text="Chuyển: Ctrl + Shift" FontSize="10"
                         Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
            <ToggleSwitch x:Name="SwLiveMode" Grid.Column="2" VerticalAlignment="Center" Click="SwLiveMode_Click"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,8,16,0">
      <TabItem x:Name="TabOverview" Header="Tổng quan">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblOverviewTitle" Text="Tổng quan &amp; Thiết lập" Classes="h1"/>
            <TextBlock x:Name="LblOverviewDesc" Text="Bảng mã, kiểu gõ và các tùy chọn tích hợp hệ thống."
                       Classes="desc" Margin="0,2,0,14"/>

            <TextBlock x:Name="LblSectionInput" Text="THIẾT LẬP BỘ GÕ" Classes="section"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblCharsetTitle" Text="Bảng mã ký tự" Classes="h2"/>
                  <TextBlock x:Name="LblCharsetDesc" Text="Mặc định Unicode NFC chuẩn quốc tế" Classes="desc"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="250">
                  <ComboBox x:Name="CboCharset" SelectionChanged="CboCharset_SelectionChanged"/>
                  <Button x:Name="BtnEditCharset" Content="Sửa bảng mã..." Classes="ghost" Margin="0,6,0,0"
                          Click="BtnEditCharset_Click"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblMethodTitle" Text="Kiểu gõ" Classes="h2"/>
                  <TextBlock x:Name="LblMethodDesc" Text="Hỗ trợ Telex, Simple Telex, VNI và VIQR" Classes="desc"/>
                </StackPanel>
                <ComboBox x:Name="CboMethod" Grid.Column="1" Width="250"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,250">
                  <StackPanel>
                    <TextBlock x:Name="LblSwitchKeyTitle" Text="Phím chuyển đổi (V / E)" Classes="h2"/>
                    <TextBlock x:Name="LblSwitchKeyDesc" Text="Hỗ trợ gán phím tùy biến thuận tiện" Classes="desc"/>
                  </StackPanel>
                  <ComboBox x:Name="CboToggleHotkey" Grid.Column="1" SelectionChanged="CboToggleHotkey_SelectionChanged"/>
                </Grid>
                <Grid x:Name="RowCustomHotkey" IsVisible="False" Margin="0,10,0,0" ColumnDefinitions="*,250">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblCustomHotkeyPrompt" Text="Phím tắt tự gán:" Classes="h2"/>
                    <TextBlock x:Name="LblCustomHotkeyHint" Text="Bấm vào ô bên phải và nhấn tổ hợp phím muốn gán" Classes="desc"/>
                  </StackPanel>
                  <TextBox x:Name="TxtCustomHotkey" Grid.Column="1" IsReadOnly="True" TextAlignment="Center"
                           Text="Bấm để gán phím" KeyDown="TxtCustomHotkey_KeyDown"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,250">
                <StackPanel>
                  <TextBlock x:Name="LblUiLangTitle" Text="Ngôn ngữ giao diện" Classes="h2"/>
                  <TextBlock x:Name="LblUiLangDesc" Text="Chọn hiển thị Tiếng Việt hoặc English" Classes="desc"/>
                </StackPanel>
                <ComboBox x:Name="CboUiLanguage" Grid.Column="1" SelectionChanged="CboUiLanguage_SelectionChanged"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,250">
                <StackPanel>
                  <TextBlock x:Name="LblThemeTitle" Text="Chế độ màu" Classes="h2"/>
                  <TextBlock x:Name="LblThemeDesc" Text="Theo hệ thống, Sáng hoặc Tối" Classes="desc"/>
                </StackPanel>
                <ComboBox x:Name="CboTheme" Grid.Column="1" SelectionChanged="CboTheme_SelectionChanged"/>
              </Grid>
            </Border>

            <TextBlock x:Name="LblSectionSystem" Text="TÍCH HỢP HỆ THỐNG" Classes="section"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblStartWithWinTitle" Text="Khởi động cùng Windows" Classes="h2"/>
                  <TextBlock x:Name="LblStartWithWinDesc" Text="Tự động khởi động khi đăng nhập Windows" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwStartWithWindows" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblSoundTitle" Text="Âm thanh thông báo" Classes="h2"/>
                  <TextBlock x:Name="LblSoundDesc" Text="Phát âm thanh khi chuyển đổi V / E" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwNotificationSound" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblTrayTitle" Text="Tùy chỉnh Tray icon" Classes="h2"/>
                  <TextBlock x:Name="LblTrayDesc" Text="Màu badge và màu chữ V / E trên khay hệ thống" Classes="desc"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Spacing="6">
                  <Border x:Name="TrayPreviewV" Width="36" Height="36" CornerRadius="9" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <TextBlock x:Name="TxtTrayPreviewV" Text="V" FontSize="19" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="TrayPreviewE" Width="36" Height="36" CornerRadius="9" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <TextBlock x:Name="TxtTrayPreviewE" Text="E" FontSize="19" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <Button x:Name="BtnCustomizeTray" Grid.Column="2" Content="Tùy chỉnh..."
                        Classes="ghost" Click="BtnCustomizeTray_Click"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabTyping" Header="Bộ gõ &amp; Chính tả">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblTypingTitle" Text="Bộ gõ &amp; Chính tả" Classes="h1"/>
            <TextBlock x:Name="LblTypingDesc" Text="Thuật toán sửa lỗi dính Shift, tốc ký phụ âm và quy tắc bỏ dấu chuẩn."
                       Classes="desc" Margin="0,2,0,14"/>

            <TextBlock x:Name="LblKillerFeatures" Text="TÍNH NĂNG ĐẶC BIỆT" Classes="section"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblShiftLagTitle" Text="Tự sửa dính Shift chữ thứ hai (VIệt -> Việt)" Classes="h2"/>
                  <TextBlock x:Name="LblShiftLagDesc" Text="Khắc phục lỗi gõ nhanh nhả phím Shift chậm" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwFixShiftLag" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblConsonantTitle" Text="Tốc ký phụ âm đầu (f -> ph, j -> gi, w -> qu)" Classes="h2"/>
                  <TextBlock x:Name="LblConsonantDesc" Text="Tăng tốc độ gõ bằng phím tắt phụ âm ghép" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwConsonantShortcuts" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblModernStyleTitle" Text="Đặt dấu thanh kiểu mới (oà, uỳ, oè)" Classes="h2"/>
                  <TextBlock x:Name="LblModernStyleDesc" Text="Quy chuẩn đặt dấu thanh trên âm chính hiện đại" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwModernStyle" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <TextBlock x:Name="LblSectionSpelling" Text="QUY TẮC CHÍNH TẢ &amp; BỎ DẤU" Classes="section"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblFreeMarkingTitle" Text="Cho phép gõ tự do" Classes="h2"/>
                  <TextBlock x:Name="LblFreeMarkingDesc" Text="Bỏ dấu ở bất kỳ vị trí nào trong từ" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwFreeMarking" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblSpellCheckTitle" Text="Bật kiểm tra chính tả tiếng Việt" Classes="h2"/>
                  <TextBlock x:Name="LblSpellCheckDesc" Text="Nhận diện cấu trúc âm tiết chuẩn" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwSpellCheck" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblAutoRestoreTitle" Text="Tự động khôi phục phím cho từ tiếng Anh" Classes="h2"/>
                  <TextBlock x:Name="LblAutoRestoreDesc" Text="Trả lại ký tự gốc khi từ gõ vào là tiếng Anh" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwAutoRestore" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblUseClipboardTitle" Text="Luôn sử dụng Clipboard cho Unicode" Classes="h2"/>
                  <TextBlock x:Name="LblUseClipboardDesc" Text="Gửi ký tự qua clipboard cho game/app cũ" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwUseClipboardForUnicode" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblAutoCapTitle" Text="Tự động viết hoa sau Enter . ! ?" Classes="h2"/>
                  <TextBlock x:Name="LblAutoCapDesc" Text="Viết hoa chữ cái đầu tiên của câu tiếp theo" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwAutoCapitalize" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,240">
                <StackPanel>
                  <TextBlock x:Name="LblTypingTimeoutTitle" Text="Thời gian chờ giữa các phím" Classes="h2"/>
                  <TextBlock x:Name="LblTypingTimeoutDesc"
                             Text="Từ đang gõ sẽ được chốt sau khoảng thời gian này. Tăng lên nếu bạn gõ chậm."
                             Classes="desc"/>
                </StackPanel>
                <ComboBox x:Name="CboTypingTimeout" Grid.Column="1"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabMacro" Header="Gõ tắt &amp; Biến động">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblMacroTitle" Text="Gõ tắt &amp; Biến động" Classes="h1"/>
            <TextBlock x:Name="LblMacroDesc" Text="Quản lý cụm từ viết tắt và biến động ngày giờ, clipboard."
                       Classes="desc" Margin="0,2,0,14"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblEnableMacroTitle" Text="Bật tính năng gõ tắt (Macro)" Classes="h2"/>
                  <TextBlock x:Name="LblEnableMacroDesc" Text="Bung từ thay thế khi nhấn Space hoặc dấu câu" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwEnableMacro" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock x:Name="LblMacroWhenDisabledTitle" Text="Cho phép gõ tắt khi đang tắt tiếng Việt [E]" Classes="h2"/>
                  <TextBlock x:Name="LblMacroWhenDisabledDesc" Text="Vẫn mở rộng macro khi biểu tượng khay là chữ E" Classes="desc"/>
                </StackPanel>
                <ToggleSwitch x:Name="SwMacroWhenDisabled" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,12">
              <StackPanel>
                <TextBlock x:Name="LblMacroInfoTitle" Text="Biến động thông minh trong cụm từ thay thế:" Classes="h2"
                           Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock x:Name="LblMacroInfoBody" Classes="desc" Margin="0,4,0,0"
                           Text="• @date : Tự động chèn ngày hiện tại&#x0a;• @time : Tự động chèn giờ hiện tại&#x0a;• @clipboard : Tự động dán nội dung Clipboard"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="LblMacroListHeader" Text="DANH SÁCH TỪ GÕ TẮT" Classes="section"/>

            <TextBox x:Name="TxtMacroSearch" PlaceholderText="Tìm từ gõ tắt..." Margin="0,0,0,8"
                     TextChanged="TxtMacroSearch_TextChanged"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" Spacing="6">
              <Button x:Name="BtnAddSampleMacros" Content="Thêm mẫu" Classes="ghost" Click="BtnAddSampleMacros_Click"/>
              <Button x:Name="BtnImportMacros" Content="Nhập .txt" Classes="ghost" Click="BtnImportMacros_Click"/>
              <Button x:Name="BtnExportMacros" Content="Xuất .txt" Classes="ghost" Click="BtnExportMacros_Click"/>
              <Button x:Name="BtnClearMacros" Content="Xóa hết" Classes="ghost" Click="BtnClearMacros_Click"/>
            </StackPanel>

            <Grid ColumnDefinitions="160,*" Margin="10,0,10,4">
              <TextBlock x:Name="LblMacroKeyColumn" Text="Từ viết tắt" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock x:Name="LblMacroValueColumn" Grid.Column="1" Text="Cụm thay thế" FontSize="11"
                         FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,0,6">
              <ListBox x:Name="DgMacros" Height="120" SelectionMode="Single"
                       SelectionChanged="DgMacros_SelectionChanged"
                       Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="158,*" Margin="8,7">
                      <TextBlock Text="{Binding Key}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}"
                                 Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <TextBlock x:Name="TxtMacroCount" Text="0 từ gõ tắt" Classes="muted" Margin="0,0,0,8"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="170,*,Auto,Auto">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock x:Name="LblMacroKeyLabel" Text="Từ viết tắt" Classes="muted" Margin="0,0,0,4"/>
                  <TextBox x:Name="TxtMacroKey" PlaceholderText="Từ gõ tắt" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock x:Name="LblMacroValueLabel" Text="Cụm thay thế" Classes="muted" Margin="0,0,0,4"/>
                  <TextBox x:Name="TxtMacroValue" PlaceholderText="Cụm thay thế" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnAddMacro" Grid.Column="2" Content="Lưu từ" Classes="primary"
                        Margin="0,0,8,0" VerticalAlignment="Bottom" Click="BtnAddMacro_Click"/>
                <Button x:Name="BtnDeleteMacro" Grid.Column="3" Content="Xóa" Classes="danger"
                        VerticalAlignment="Bottom" Click="BtnDeleteMacro_Click"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabGame" Header="Game &amp; Ứng dụng">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblGameTitle" Text="Game &amp; Ứng dụng thông minh" Classes="h1"/>
            <TextBlock x:Name="LblGameDesc" Text="Tự động chuyển chế độ tiếng Anh hoặc bỏ qua hook khi chơi game."
                       Classes="desc" Margin="0,2,0,14"/>

            <TextBlock x:Name="LblExcludedAppsHeader" Text="DANH SÁCH ỨNG DỤNG LOẠI TRỪ (GAME MODE)" Classes="section"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" Spacing="6">
              <Button x:Name="BtnPickRunningProcess" Content="Chọn tiến trình..." Classes="primary" Click="BtnPickRunningProcess_Click"/>
              <Button x:Name="BtnBrowseExe" Content="Duyệt file .exe..." Classes="ghost" Click="BtnBrowseExe_Click"/>
              <Button x:Name="BtnClearExcludedApps" Content="Xóa hết" Classes="ghost" Click="BtnClearExcludedApps_Click"/>
            </StackPanel>

            <ListBox x:Name="LstExcludedApps" Height="280" Margin="0,0,0,8">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" Margin="6,4">
                    <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform"/>
                      <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6"
                              IsVisible="{Binding ShowPlaceholder}">
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Exe}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtExcludedAppsCount" Text="0 ứng dụng loại trừ" Classes="muted" Margin="0,0,0,8"/>

            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox x:Name="TxtAppProcess" PlaceholderText="Nhập file .exe (ví dụ: cs2.exe)" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
              <Button x:Name="BtnAddApp" Grid.Column="1" Content="Thêm thủ công" Classes="primary" Margin="0,0,6,0" Click="BtnAddApp_Click"/>
              <Button x:Name="BtnDeleteApp" Grid.Column="2" Content="Xóa" Classes="danger" Click="BtnDeleteApp_Click"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabAdvanced" Header="Nâng cao">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblAdvancedTitle" Text="Cấu hình nâng cao" Classes="h1"/>
            <TextBlock x:Name="LblAdvancedDesc" Text="Tùy chỉnh các danh sách từ và tham số ít dùng của engine."
                       Classes="desc" Margin="0,2,0,14"/>

            <TextBlock x:Name="LblKeywordSection" Text="DANH SÁCH TỪ" Classes="section"/>

            <Border Classes="card">
              <StackPanel>
                <TextBlock x:Name="LblKeywordsTitle" Text="Từ tiếng Anh / từ ngoại lai" Classes="h2"/>
                <TextBlock x:Name="LblKeywordsDesc" Text="Mỗi dòng một từ. Các từ này sẽ không bị bỏ dấu tiếng Việt."
                           Classes="desc" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtEnglishKeywords" Height="240" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         TextChanged="TxtEnglishKeywords_TextChanged"/>
                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto">
                  <TextBlock x:Name="TxtKeywordsCount" Text="0 từ" Classes="muted" VerticalAlignment="Center"/>
                  <Button x:Name="BtnResetKeywords" Grid.Column="1" Content="Khôi phục mặc định" Classes="ghost" Margin="0,0,8,0" Click="BtnResetKeywords_Click"/>
                  <Button x:Name="BtnSaveKeywords" Grid.Column="2" Content="Lưu danh sách" Classes="primary" Click="BtnSaveKeywords_Click"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,160">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock x:Name="LblForeignTitle" Text="Phụ âm đầu nước ngoài" Classes="h2"/>
                  <TextBlock x:Name="LblForeignDesc" Text="Các chữ cái đầu này sẽ không nhận dấu tiếng Việt (mặc định: fjwz)."
                             Classes="desc"/>
                </StackPanel>
                <TextBox x:Name="TxtForeignInitials" Grid.Column="1" MaxLength="26" FontFamily="Consolas" VerticalContentAlignment="Center"/>
              </Grid>
            </Border>

            <TextBlock x:Name="LblMacroVarsSection" Text="BIẾN ĐỘNG MACRO" Classes="section"/>

            <Border Classes="card">
              <StackPanel>
                <TextBlock x:Name="LblMacroFormatsTitle" Text="Định dạng ngày / giờ" Classes="h2"/>
                <TextBlock x:Name="LblMacroFormatsDesc" Text="Dùng cú pháp .NET, ví dụ dd/MM/yyyy hoặc HH:mm." Classes="desc"/>
                <Grid ColumnDefinitions="*,*,*" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LblMacroDateFormat" Text="@date" Classes="muted" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMacroDateFormat" FontFamily="Consolas" PlaceholderText="dd/MM/yyyy" VerticalContentAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock x:Name="LblMacroTimeFormat" Text="@time" Classes="muted" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMacroTimeFormat" FontFamily="Consolas" PlaceholderText="HH:mm" VerticalContentAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="LblMacroDateTimeFormat" Text="@datetime" Classes="muted" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMacroDateTimeFormat" FontFamily="Consolas" PlaceholderText="dd/MM/yyyy HH:mm" VerticalContentAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,12,0,10"/>

                <TextBlock x:Name="LblMacroCustomTitle" Text="Biến tùy chỉnh" Classes="h2"/>
                <TextBlock x:Name="LblMacroCustomDesc" Text="Mỗi dòng một biến dạng tên=giá trị; dùng @tên trong macro."
                           Classes="desc" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtMacroVariables" Height="110" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         PlaceholderText="name=Kien&#x0a;company=VietFlow"/>
                <TextBlock x:Name="LblMacroBuiltins" Text="Có sẵn: @date @time @datetime @day @month @year @weekday @timestamp @random @uuid @user @computer @clipboard @newline @tab"
                           Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="LblAdvancedSystem" Text="HỆ THỐNG" Classes="section"/>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="Tệp cấu hình" Classes="h2"/>
                  <TextBlock x:Name="TxtConfigPath" Text="%APPDATA%\VietFlow\vietflow_config.json" Classes="desc"/>
                </StackPanel>
                <Button x:Name="BtnOpenConfigFolder" Grid.Column="1" Content="Mở thư mục" Classes="ghost"
                        Click="BtnOpenConfigFolder_Click"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabAbout" Header="Giới thiệu">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,8,4,16">
            <TextBlock x:Name="LblAboutTitle" Text="Giới thiệu VietFlow" Classes="h1"/>
            <TextBlock x:Name="LblAboutDesc" Text="Bộ gõ tiếng Việt hiệu năng cao." Classes="desc" Margin="0,2,0,14"/>

            <Border Classes="card" Padding="18">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="56" Height="56" Background="{DynamicResource PrimaryBrush}" CornerRadius="14" Margin="0,0,16,0">
                    <Image Width="32" Height="32" Source="avares://VietFlow/Assets/app-logo.png"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VietFlow" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtAboutVersion" Text="Phiên bản 0.1.0-alpha" Classes="desc"/>
                  </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,16,0,14"/>

                <TextBlock x:Name="TxtAboutLicense" Text="Giấy phép GNU GPL v3.0 · Dựa trên UniKey của Phạm Kim Long" Classes="desc" Margin="0,0,0,14"/>

                <TextBlock x:Name="LblAboutLinks" Text="LIÊN KẾT" Classes="section"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="GitHub Repository" Classes="link" Click="GitHubLink_Click"/>
                  <TextBlock Text="·" Foreground="{DynamicResource TextMuted}"/>
                  <Button Content="UniKey" Classes="link" Click="UniKeyLink_Click"/>
                  <TextBlock Text="·" Foreground="{DynamicResource TextMuted}"/>
                  <Button Content="EVKey" Classes="link" Click="EvKeyLink_Click"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,16,0,14"/>
                <TextBlock x:Name="LblUpdateSection" Text="CẬP NHẬT ỨNG DỤNG" Classes="section"/>

                <Border Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUpdateStatus" Text="Kiểm tra bản cập nhật mới nhất" Classes="h2"/>
                        <TextBlock x:Name="TxtUpdateDetail" Text="Kiểm tra trực tiếp từ GitHub" Classes="desc" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Button x:Name="BtnCheckUpdate" Grid.Column="1" Content="Kiểm tra cập nhật" Classes="primary"
                              Margin="10,0,0,0" Click="BtnCheckUpdate_Click"/>
                    </Grid>
                    <ProgressBar x:Name="PrgUpdate" Height="5" Margin="0,8,0,0" IsVisible="False"
                                 Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}"/>
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="LblAutoUpdate" Text="Tự động kiểm tra cập nhật" Classes="h2"/>
                      <TextBlock x:Name="TxtAboutNote" Text="Nhấn Ctrl + Shift để chuyển nhanh giữa tiếng Việt [V] và English [E]."
                                 Classes="desc"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="SwAutoCheckUpdates" Grid.Column="1" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource ChromeBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
            Padding="18,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button x:Name="BtnReset" Content="Khôi phục mặc định" Classes="ghost" Click="BtnReset_Click"/>
        <Button x:Name="BtnClose" Grid.Column="2" Content="Đóng" Classes="ghost" Margin="0,0,10,0" Click="BtnClose_Click"/>
        <Button x:Name="BtnSave" Grid.Column="3" Content="Lưu cấu hình" Classes="primary" Click="BtnSave_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
