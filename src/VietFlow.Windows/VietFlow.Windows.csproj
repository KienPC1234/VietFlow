<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VietFlow</AssemblyName>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-alpha</InformationalVersion>
    <ApplicationIcon>Assets\VietFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>VietFlow.Windows.Program</StartupObject>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>

    <!-- Desktop workstation GC: lower memory than server GC for a tray app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Release publish defaults: one compressed, trimmed, self-contained exe.
       Normal `dotnet build` is unaffected because these only apply with a RID. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">true</PublishTrimmed>
    <TrimMode Condition="'$(TrimMode)' == ''">partial</TrimMode>
    <SuppressTrimAnalysisWarnings Condition="'$(PublishTrimmed)' == 'true'">true</SuppressTrimAnalysisWarnings>
    <DebugType Condition="'$(DebugType)' == ''">none</DebugType>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Keep reflection-heavy infrastructure available in the trimmed single file. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="Velopack" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Controls.ColorPicker" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VietFlow\VietFlow.csproj" />
  </ItemGroup>

  <!-- Native Skia/HarfBuzz packages ship huge PDBs. They are not needed for a
       release app and would otherwise add ~100 MB to the publish folder. -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbToDelete)" />
  </Target>

</Project>
